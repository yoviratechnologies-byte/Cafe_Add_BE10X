# ==============================================================================
# Aura Artisanal Cafe & Roastery — Environment Variables Specification
# Copy this file to .env or .env.local for development and staging
# ==============================================================================

# Application Runtime
NODE_ENV=development
PORT=3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_CAFE_NAME="Aura Artisanal Cafe & Roastery"
NEXT_PUBLIC_CAFE_TIMEZONE="Asia/Kolkata"

# Database Configuration (PostgreSQL / Supabase / SQLite)
DATABASE_URL="postgresql://postgres:password@localhost:5432/aura_cafe?schema=public"
# For local persistent JSON/File engine
DATA_FILE_PATH="./data/database.json"

# Authentication (Supabase / NextAuth / Custom JWT)
JWT_SECRET="replace-with-a-secure-random-64-character-secret-in-production"
ADMIN_SESSION_COOKIE="aura_admin_session"

# Payment Gateway (Razorpay India Sandbox / Production)
RAZORPAY_KEY_ID="rzp_test_placeholder_key_aura"
RAZORPAY_KEY_SECRET="placeholder_secret_never_commit_live_keys"
RAZORPAY_WEBHOOK_SECRET="whsec_placeholder_webhook_secret_aura"
NEXT_PUBLIC_RAZORPAY_KEY_ID="rzp_test_placeholder_key_aura"

# Cloud Media Storage (Cloudinary / S3 / Supabase Storage)
STORAGE_BUCKET_NAME="aura-cafe-media"
STORAGE_API_KEY="placeholder_storage_key"
STORAGE_API_SECRET="placeholder_storage_secret"

# Notification Services (Transactional SMS / Email / WhatsApp)
SMTP_HOST="smtp.mailtrap.io"
SMTP_PORT=587
SMTP_USER="placeholder_smtp_user"
SMTP_PASS="placeholder_smtp_pass"
NOTIFICATIONS_FROM_EMAIL="orders@auracafe.com"
NOTIFICATIONS_STAFF_PHONE="+919876543210"

# Feature Flags
ENABLE_3D_WEBGL=true
ENABLE_ONLINE_ORDERING=true
ENABLE_TABLE_RESERVATIONS=true
